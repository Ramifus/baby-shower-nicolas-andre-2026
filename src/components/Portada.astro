---
// src/components/Portada.astro
// Portada Baby Shower — temática vaquerita (cowboy)
// El diseño vive dentro de #marco, un lienzo con la proporción exacta de
// fondo1.png (941 x 1672). Los tamaños van en cqw (1cqw = 1% del ancho del
// marco) y las posiciones en % del alto, así la composición acompaña al
// fondo aunque la pantalla sea más alta o más baja.
---

<section id="portada-section">
    <!-- Fondo difuminado que rellena la pantalla en cualquier proporción -->
    <div id="backdrop"></div>

    <!-- ═══════════ LIENZO DE PROPORCIÓN FIJA ═══════════ -->
    <div id="marco">
        <!-- ── Guirnalda de arriba, de borde a borde ── -->
        <img id="florarriba" src="/imagenes/florarriba.png" alt="" />

        <!-- ── Título: BABY (serif) + Shower (cursiva dorada) ── -->
        <div id="titulo-wrap">
            <h1 id="titulo">
                <span id="titulo-baby">Baby</span>
                <span id="titulo-shower">Shower</span>
            </h1>

            <!-- corazoncito con dos trazos, debajo del título -->
            <svg id="filigrana" viewBox="0 0 220 34" aria-hidden="true">
                <path
                    d="M6 20 C34 8 62 8 88 18"
                    fill="none"
                    stroke="#c49a4e"
                    stroke-width="2.2"
                    stroke-linecap="round"></path>
                <path
                    d="M214 20 C186 8 158 8 132 18"
                    fill="none"
                    stroke="#c49a4e"
                    stroke-width="2.2"
                    stroke-linecap="round"></path>
                <path
                    d="M110 30 C96 20 92 12 99 7 C104 3 109 6 110 10 C111 6 116 3 121 7 C128 12 124 20 110 30 Z"
                    fill="none"
                    stroke="#c49a4e"
                    stroke-width="2.4"
                    stroke-linejoin="round"></path>
            </svg>
        </div>

        <!-- ── Adornos de los costados ── -->
        <img id="herradura" src="/imagenes/herradura.png" alt="" />
        <img id="rueda" src="/imagenes/rueda.png" alt="" />

        <svg class="estrella" id="estrella-1" viewBox="0 0 24 24" aria-hidden="true">
            <path
                d="M12 1.6 15.2 8.5 22.6 9.4 17.2 14.4 18.6 21.8 12 18.2 5.4 21.8 6.8 14.4 1.4 9.4 8.8 8.5 Z"
                fill="#dcb488"></path>
        </svg>
        <svg class="estrella" id="estrella-2" viewBox="0 0 24 24" aria-hidden="true">
            <path
                d="M12 1.6 15.2 8.5 22.6 9.4 17.2 14.4 18.6 21.8 12 18.2 5.4 21.8 6.8 14.4 1.4 9.4 8.8 8.5 Z"
                fill="#dcb488"></path>
        </svg>
        <svg class="estrella" id="estrella-3" viewBox="0 0 24 24" aria-hidden="true">
            <path
                d="M12 1.6 15.2 8.5 22.6 9.4 17.2 14.4 18.6 21.8 12 18.2 5.4 21.8 6.8 14.4 1.4 9.4 8.8 8.5 Z"
                fill="#dcb488"></path>
        </svg>

        <!-- ── Sobre (clic para abrir) ── -->
        <div
            id="sobre-container"
            role="button"
            tabindex="0"
            aria-label="Abrir invitación"
        >
            <img src="/imagenes/sobre.png" alt="Sobre de invitación" />
        </div>

        <p id="instruccion" class="font-cinzel">
            Haz clic en el sobre <br />para ver la invitación
        </p>

        <img id="separador" src="/imagenes/sepa.png" alt="" />

        <!-- ── Escena de abajo: el vaquerito con los cactus y la rueda ── -->
        <img id="abajo" src="/imagenes/abajo.png" alt="" />

        <!-- ── Frase de cierre ── -->
        <p id="frase" class="font-crimson">
            <svg class="rayitas" viewBox="0 0 34 24" aria-hidden="true">
                <path
                    d="M2 5 L14 9 M0 12 L13 12 M2 19 L14 15"
                    stroke="#b98a5e"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    fill="none"></path>
            </svg>
            <span>Un vaquerito viene en camino</span>
            <svg class="rayitas rayitas-der" viewBox="0 0 34 24" aria-hidden="true">
                <path
                    d="M2 5 L14 9 M0 12 L13 12 M2 19 L14 15"
                    stroke="#b98a5e"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    fill="none"></path>
            </svg>
        </p>

        <svg id="corazon-final" viewBox="0 0 30 26" aria-hidden="true">
            <path
                d="M15 24 C3 15 1 9 6 4.5 C10 1 14 4 15 7 C16 4 20 1 24 4.5 C29 9 27 15 15 24 Z"
                fill="none"
                stroke="#b98a5e"
                stroke-width="2.2"
                stroke-linejoin="round"></path>
        </svg>
    </div>
</section>

<style is:global>
    /* Bloquea el scroll mientras la portada está visible */
    body.portada-activa {
        overflow: hidden !important;
        height: 100vh;
    }
</style>

<style>
    #portada-section {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background-color: #f6ecd9;
    }

    /* Relleno para pantallas más altas/anchas que el lienzo */
    #backdrop {
        position: absolute;
        inset: -8%;
        background: url("/imagenes/fondo3.png") center / cover no-repeat;
        filter: blur(22px) saturate(1.04);
        transform: scale(1.1);
        pointer-events: none;
    }

    /* ═══════════ LIENZO (proporción de fondo1.png: 941 x 1672) ═══════════ */
    #marco {
        position: relative;
        /* fallback para navegadores sin svh */
        width: min(100vw, 480px, calc(100vh * 941 / 1672));
        width: min(100vw, 480px, calc(100svh * 941 / 1672));
        height: 100vh;
        height: 100svh;
        container-type: size;
        /* fondo1.png es papel liso: entra como cover, sin estirarse */
        background: url("/imagenes/fondo3.png") center center / cover no-repeat;
        overflow: hidden;
        box-shadow: 0 0 60px rgba(120, 90, 60, 0.28);
    }

    #marco img {
        display: block;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* ── Guirnalda de arriba: ocupa todo el ancho del marco ── */
    #florarriba {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: auto;
        z-index: 2;
        pointer-events: none;
    }

    /* ── Título ── */
    #titulo-wrap {
        position: absolute;
        top: 15%;
        left: 50%;
        transform: translateX(-50%);
        width: 92cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 4;
        pointer-events: none;
    }

    #titulo {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: 0;
        line-height: 1;
    }

    /* BABY: serif en versales, terracota rosado */
    #titulo-baby {
        font-family: "Cinzel", serif;
        font-weight: 500;
        font-size: 17.5cqw;
        line-height: 1;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        color: #b9866b;
        background: linear-gradient(180deg, #c49279 0%, #ab7359 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* SHOWER: misma fuente y mismo color que BABY, un renglón abajo */
    #titulo-shower {
        font-family: "Cinzel", serif;
        font-weight: 500;
        font-size: 11cqw;
        line-height: 1;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-top: 1cqw;
        color: #b9866b;
        background: linear-gradient(180deg, #c49279 0%, #ab7359 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    #filigrana {
        width: 25cqw;
        height: auto;
        margin-top: 1.5cqw;
    }

    /* ── Adornos de los costados ── */
    #herradura {
        position: absolute;
        top: 21%;
        left: 4.5%;
        width: 11cqw;
        height: auto;
        transform: rotate(-12deg);
        z-index: 3;
        pointer-events: none;
        filter: drop-shadow(0 3px 6px rgba(150, 110, 70, 0.22));
    }

    #rueda {
        position: absolute;
        /* a la misma altura que la herradura del otro costado */
        top: 21%;
        right: 3.5%;
        width: 11.5cqw;
        height: auto;
        z-index: 3;
        pointer-events: none;
        filter: drop-shadow(0 3px 6px rgba(150, 110, 70, 0.22));
    }

    .estrella {
        position: absolute;
        z-index: 3;
        pointer-events: none;
    }

    #estrella-1 {
        top: 20.5%;
        right: 13%;
        width: 4.6cqw;
    }

    #estrella-2 {
        top: 29.5%;
        left: 6%;
        width: 5.2cqw;
    }

    #estrella-3 {
        top: 36%;
        right: 5.5%;
        width: 3.6cqw;
    }

    /* ── Sobre ── */
    #sobre-container {
        position: absolute;
        top: 35%;
        left: 50%;
        transform: translateX(-50%);
        width: 78cqw;
        z-index: 5;
        cursor: pointer;
        outline: none;
    }

    #sobre-container img {
        width: 100%;
        height: auto;
        /* sin luminancia: el sobre va limpio, sin halo ni sombra */
        filter: none;
    }

    /* ── Instrucción ── */
    #instruccion {
        position: absolute;
        top: 57.5%;
        left: 50%;
        transform: translateX(-50%);
        width: 86cqw;
        margin: 0;
        font-size: 4.8cqw;
        font-weight: 600;
        line-height: 1.45;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        text-align: center;
        color: #6d4830;
        cursor: pointer;
        z-index: 5;
        text-shadow: 0 1px 0 rgba(255, 252, 245, 0.85);
    }

    #separador {
        position: absolute;
        /* justo debajo de "Haz clic en el sobre" */
        top: 65.5%;
        left: 50%;
        transform: translateX(-50%);
        width: 44cqw;
        height: auto;
        opacity: 1 !important;
        z-index: 6;
        pointer-events: none;
    }

    /* ── Escena de abajo ── */
    #abajo {
        position: absolute;
        bottom: 6%;
        left: 50%;
        transform: translateX(-50%);
        width: 90cqw;
        height: auto;
        z-index: 4;
        pointer-events: none;
    }

    /* ── Frase de cierre ── */
    #frase {
        position: absolute;
        bottom: 3.8%;
        left: 50%;
        transform: translateX(-50%);
        width: 92cqw;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 2.5cqw;
        font-size: 5.4cqw;
        font-style: italic;
        font-weight: 600;
        line-height: 1.2;
        text-align: center;
        color: #8a5a3b;
        z-index: 5;
        text-shadow: 0 1px 0 rgba(255, 252, 245, 0.85);
    }

    .rayitas {
        width: 6cqw;
        height: auto;
        flex: none;
    }

    .rayitas-der {
        transform: scaleX(-1);
    }

    #corazon-final {
        position: absolute;
        bottom: 1.4%;
        left: 50%;
        transform: translateX(-50%);
        width: 4cqw;
        height: auto;
        z-index: 4;
        pointer-events: none;
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            const adornos = ["#herradura", "#rueda", ".estrella"];

            // ── Estado inicial ──────────────────────────────────────
            gsap.set("#florarriba", { opacity: 0, y: "-30%" });
            gsap.set("#titulo-wrap", { opacity: 0, y: -14, scale: 0.94 });
            gsap.set("#sobre-container", { opacity: 0, y: 26, scale: 0.9 });
            gsap.set("#instruccion", { opacity: 0, y: 10 });
            gsap.set("#abajo", { opacity: 0, y: 24, scale: 0.94 });
            gsap.set(["#frase", "#corazon-final"], { opacity: 0, y: 12 });
            gsap.set(adornos, { opacity: 0, scale: 0.7 });

            // ── Entrada ─────────────────────────────────────────────
            const tl = gsap.timeline({ delay: 0.25 });

            // Todo entra a la vez
            tl.to(
                "#florarriba",
                { opacity: 1, y: 0, duration: 1.4, ease: "power2.out" },
                0,
            ).to(
                "#titulo-wrap",
                {
                    opacity: 1,
                    y: 0,
                    scale: 1,
                    duration: 1.2,
                    ease: "back.out(1.4)",
                },
                0,
            )
                .to(
                    "#sobre-container",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "back.out(1.4)",
                    },
                    0,
                )
                .to(
                    "#instruccion",
                    { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" },
                    0,
                )
                .to(
                    "#abajo",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.3,
                        ease: "back.out(1.3)",
                    },
                    0.2,
                )
                .to(
                    ["#frase", "#corazon-final"],
                    {
                        opacity: 1,
                        y: 0,
                        duration: 1.1,
                        stagger: 0.08,
                        ease: "power2.out",
                    },
                    0.45,
                )
                .to(
                    adornos,
                    {
                        opacity: 1,
                        scale: 1,
                        duration: 0.9,
                        stagger: 0.1,
                        ease: "back.out(1.6)",
                    },
                    0.35,
                );

            // ── Reposo ──────────────────────────────────────────────
            tl.add(() => {
                // El sobre late para invitar al toque
                gsap.to("#sobre-container", {
                    scale: 1.035,
                    duration: 1.9,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
                gsap.to("#instruccion", {
                    opacity: 0.62,
                    duration: 1.4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            }, 1.4);

            // ── Hover sobre ─────────────────────────────────────────
            const sobreContainer = document.getElementById("sobre-container");

            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to("#sobre-container", {
                    y: -8,
                    scale: 1.06,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });
            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to("#sobre-container", {
                    y: 0,
                    scale: 1,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            // ── Click ───────────────────────────────────────────────
            const portadaSection = document.getElementById("portada-section");

            const abrirInvitacion = () => {
                gsap.killTweensOf([
                    "#florarriba",
                    "#titulo-wrap",
                    "#sobre-container",
                    "#instruccion",
                    "#separador",
                    "#abajo",
                    "#frase",
                    "#corazon-final",
                    ...adornos,
                ]);

                const audio = new Audio("/musica/melo.mp3");
                audio.loop = true;
                audio.volume = 0.5;
                audio.play().catch(() => {});

                (window as any).audioGlobal = audio;
                (window as any).estaReproduciendoGlobal = true;
                window.dispatchEvent(new CustomEvent("musica-iniciada"));

                const tlSalida = gsap.timeline();

                tlSalida
                    .to("#sobre-container", {
                        scale: 1.1,
                        duration: 0.2,
                        ease: "power2.in",
                    })
                    .to(
                        [
                            "#instruccion",
                            "#separador",
                            "#titulo-wrap",
                            "#florarriba",
                            "#abajo",
                            "#frase",
                            "#corazon-final",
                            ...adornos,
                        ],
                        {
                            opacity: 0,
                            y: -16,
                            duration: 0.4,
                            stagger: 0.04,
                            ease: "power2.in",
                        },
                        0.1,
                    )
                    .to(
                        "#sobre-container",
                        {
                            opacity: 0,
                            scale: 1.35,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0.3,
                    )
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove(
                                    "portada-activa",
                                );
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                window.scrollTo({ top: 0, behavior: "smooth" });

                                // Avisa al resto de secciones: recién ahora
                                // se ven, así que recién ahora deben animar.
                                (window as any).invitacionAbierta = true;
                                window.dispatchEvent(
                                    new CustomEvent("invitacion-abierta"),
                                );
                            },
                        },
                        0.5,
                    );
            };

            sobreContainer?.addEventListener("click", abrirInvitacion);
            document
                .getElementById("instruccion")
                ?.addEventListener("click", abrirInvitacion);
            sobreContainer?.addEventListener("keydown", (e) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    abrirInvitacion();
                }
            });
        });
    }
</script>
