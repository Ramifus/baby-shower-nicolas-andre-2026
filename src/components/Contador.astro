---
// src/components/Contador.astro
// Cuenta regresiva: un rectángulo blanco con trazo rosa, el título en script
// rosa sobre versalitas doradas y los números separados por dos puntos.
// Sin adornos dentro. La fecha no se repite aquí: ya la muestra Fecha.astro.
---

<section id="contador-section">
  <div id="cd-wrap">
    <!-- ═══════ TARJETA ═══════ -->
    <div id="cd-card">
      <!-- flores asomando en las dos esquinas de arriba -->
      <div id="cd-flor-izq"><img src="/imagenes/flor.png" alt="" /></div>
      <div id="cd-flor-der"><img src="/imagenes/flor.png" alt="" /></div>

      <!-- ── Título ── -->
      <p id="cd-cuenta" class="font-great-vibes">Cuenta</p>
      <p id="cd-regresiva" class="font-cinzel">Regresiva</p>

      <!-- ── Números ── -->
      <div id="cd-numeros">
        <div class="cd-box">
          <p id="dias" class="cd-num font-cinzel">00</p>
          <p class="cd-lbl font-cinzel">Días</p>
        </div>

        <span class="cd-sep font-cinzel">:</span>

        <div class="cd-box">
          <p id="horas" class="cd-num font-cinzel">00</p>
          <p class="cd-lbl font-cinzel">Horas</p>
        </div>

        <span class="cd-sep font-cinzel">:</span>

        <div class="cd-box">
          <p id="minutos" class="cd-num font-cinzel">00</p>
          <p class="cd-lbl font-cinzel">Minutos</p>
        </div>

        <span class="cd-sep font-cinzel">:</span>

        <div class="cd-box">
          <p id="segundos" class="cd-num font-cinzel">00</p>
          <p class="cd-lbl font-cinzel">Segundos</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #contador-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    background: transparent;
    padding: 1rem 0 1.5rem;
  }

  #cd-wrap {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
  }

  #cd-wrap img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* ═══════ TARJETA ═══════ */
  /* Un rectángulo blanco con trazo rosa y esquinas bien redondeadas. */
  #cd-card {
    position: relative;
    z-index: 2;
    margin: 0 5cqw;
    padding: 7cqw 4cqw 6cqw;
    text-align: center;
    background: #ffffff;
    border: 1px solid #e5a8bd;
    border-radius: 8cqw;
    /* recorta las flores contra la curva de las esquinas */
    overflow: hidden;
  }

  /* ── Flores de las esquinas ── */
  /* En el archivo el ramo está a la izquierda, así que la de la derecha va
     volteada: el volteo en el <img> y la animación en el contenedor, porque
     GSAP escribe su propio transform. */
  #cd-flor-izq,
  #cd-flor-der {
    position: absolute;
    top: -3cqw;
    width: 40cqw;
    opacity: 0.9;
    z-index: 0;
    pointer-events: none;
  }

  #cd-flor-izq {
    left: -6cqw;
  }

  #cd-flor-der {
    right: -6cqw;
  }

  #cd-flor-izq img,
  #cd-flor-der img {
    width: 100%;
    height: auto;
  }

  #cd-flor-der img {
    transform: scaleX(-1);
  }

  /* ── Título ── */
  #cd-cuenta {
    position: relative;
    z-index: 2;
    margin: 0;
    font-size: 9cqw;
    line-height: 1;
    color: #e58aa6;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  #cd-regresiva {
    position: relative;
    z-index: 2;
    margin: 0.8cqw 0 0;
    font-size: 5.2cqw;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: 0.18em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.18em;
    text-transform: uppercase;
    color: #c08b3e;
  }

  /* ── Números ── */
  #cd-numeros {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 1.4cqw;
    margin-top: 5cqw;
  }

  .cd-box {
    width: 17cqw;
  }

  .cd-num {
    margin: 0;
    font-size: 9cqw;
    font-weight: 400;
    line-height: 1;
    color: #e58aa6;
  }

  .cd-lbl {
    margin: 2cqw 0 0;
    font-size: 2.7cqw;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    text-indent: 0.12em;
    color: #4f4340;
  }

  /* los dos puntos van a la altura de las cifras, no de las etiquetas */
  .cd-sep {
    padding-top: 1cqw;
    font-size: 6.5cqw;
    line-height: 1;
    color: #e5a8bd;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  // 29 de agosto de 2026, 14:30
  const FECHA_EVENTO = { año: 2026, mes: 8, dia: 29, hora: 14, minuto: 30 };

  const initContador = () => {
    const inicial = () => {
      // cada pieza llega desde un sitio distinto
      gsap.set("#cd-card", { opacity: 0, y: 26, scale: 0.96 });
      gsap.set("#cd-flor-izq", { opacity: 0, x: "-35%", y: "-30%" });
      gsap.set("#cd-flor-der", { opacity: 0, x: "35%", y: "-30%" });
      gsap.set("#cd-cuenta", { opacity: 0, y: -24 });
      gsap.set("#cd-regresiva", { opacity: 0, y: 20 });
      // los cuatro recuadros entran uno de cada dirección
      gsap.set("#dias", { opacity: 0, x: -34 });
      gsap.set("#horas", { opacity: 0, y: -30 });
      gsap.set("#minutos", { opacity: 0, y: 30 });
      gsap.set("#segundos", { opacity: 0, x: 34 });
      gsap.set(".cd-lbl", { opacity: 0, y: 10 });
      gsap.set(".cd-sep", { opacity: 0, scale: 0.4 });
    };

    inicial();

    ScrollTrigger.create({
      trigger: "#contador-section",
      start: "top 82%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(
          "#cd-card",
          { opacity: 1, y: 0, scale: 1, duration: 1.1, ease: "power2.out" },
          0,
        )
          .to(
            ["#cd-flor-izq", "#cd-flor-der"],
            { opacity: 0.9, x: 0, y: 0, duration: 1.5, ease: "power2.out" },
            0.15,
          )
          .to(
            "#cd-cuenta",
            { opacity: 1, y: 0, duration: 1.4, ease: "back.out(1.2)" },
            0.25,
          )
          .to(
            "#cd-regresiva",
            { opacity: 1, y: 0, duration: 1.3, ease: "power3.out" },
            0.4,
          )
          .to(
            ["#dias", "#horas", "#minutos", "#segundos"],
            {
              opacity: 1,
              x: 0,
              y: 0,
              duration: 1.3,
              stagger: 0.1,
              ease: "back.out(1.3)",
            },
            0.55,
          )
          .to(
            ".cd-lbl",
            {
              opacity: 1,
              y: 0,
              duration: 1.0,
              stagger: 0.1,
              ease: "power2.out",
            },
            0.85,
          )
          .to(
            ".cd-sep",
            {
              opacity: 1,
              scale: 1,
              duration: 0.9,
              stagger: 0.1,
              ease: "back.out(2)",
            },
            1.0,
          );
      },
      onLeaveBack: inicial,
    });

    // ── Cuenta regresiva ──────────────────────────────────────
    const fechaEvento = new Date(
      FECHA_EVENTO.año,
      FECHA_EVENTO.mes - 1,
      FECHA_EVENTO.dia,
      FECHA_EVENTO.hora,
      FECHA_EVENTO.minuto,
      0,
    ).getTime();

    function actualizar() {
      const diff = fechaEvento - new Date().getTime();
      const val = diff > 0 ? diff : 0;
      const d = Math.floor(val / 86400000);
      const h = Math.floor((val % 86400000) / 3600000);
      const m = Math.floor((val % 3600000) / 60000);
      const s = Math.floor((val % 60000) / 1000);
      document.getElementById("dias")!.textContent = String(d).padStart(2, "0");
      document.getElementById("horas")!.textContent = String(h).padStart(2, "0");
      document.getElementById("minutos")!.textContent = String(m).padStart(
        2,
        "0",
      );
      document.getElementById("segundos")!.textContent = String(s).padStart(
        2,
        "0",
      );
    }

    actualizar();
    setInterval(actualizar, 1000);
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContador);
  } else {
    initContador();
  }
</script>
