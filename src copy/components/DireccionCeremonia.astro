---
// src/components/DireccionCeremonia.astro
// Recepción + Confirmar asistencia en un solo bloque: el arco rosa arriba a la
// derecha y, montado por delante, el arco crema con la confirmación.
// Mismo diseño de siempre, con la paleta rosa/dorada y flores en vez de hojas.

const lugar = {
  salon: "Torre Montreal",
  salon2: "(piso 18)",
  direccion: "Av. América entre Av. Santa Cruz y Pantaleón Dalence",
  hora: "15:00 hrs.",
};

const mapa = "https://maps.app.goo.gl/7rRMDPzJF5BJXNib7";

const confirmacion = {
  mensaje:
    "¡Hola! Confirmo mi asistencia al Baby Shower. Nos vemos el domingo 27 de septiembre.",
  // Bolivia (+591)
  telefono: "59165504338",
};

const linkConfirmar = `https://wa.me/${confirmacion.telefono}?text=${encodeURIComponent(confirmacion.mensaje)}`;
---

<section id="ceremonia-section">
  <div id="dc-wrap">
    <!-- ═══════ ARCO ROSA — RECEPCIÓN ═══════ -->
    <div id="dc-arco">
      <h3 id="dc-titulo" class="font-great-vibes">Recepción</h3>

      <!-- Pin de ubicación -->
      <svg id="dc-pin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 2.6c-3.6 0-6.5 2.9-6.5 6.5 0 4.6 5.7 10.4 6 10.6.3.3.7.3 1 0 .3-.3 6-6 6-10.6 0-3.6-2.9-6.5-6.5-6.5Zm0 9.2a2.7 2.7 0 1 1 0-5.4 2.7 2.7 0 0 1 0 5.4Z"
          fill="#ffffff"></path>
        <ellipse
          cx="12"
          cy="20.6"
          rx="4.6"
          ry="1.5"
          stroke="#ffffff"
          stroke-width="1.4"></ellipse>
      </svg>

      <p id="dc-salon" class="font-cinzel">
        {lugar.salon}<br />{lugar.salon2}
      </p>

      <p id="dc-direccion" class="font-cinzel">{lugar.direccion}</p>

      <p id="dc-hora" class="font-cinzel">{lugar.hora}</p>

      <a
        id="dc-boton"
        class="font-cinzel"
        href={mapa}
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver ubicación
      </a>
    </div>

    <!-- ═══════ FLORES (izquierda) ═══════ -->
    <div id="dc-flor"><img src="/imagenes/captus.png" alt="" /></div>

    <!-- ═══════ ARCO CREMA — CONFIRMAR ASISTENCIA ═══════ -->
    <div id="cf-arco">
      <h3 id="cf-titulo" class="font-great-vibes">
        Confirmar<br />Asistencia
      </h3>

      <!-- separador dorado -->
      <div id="cf-divisor">
        <span class="cf-div-linea"></span>
        <span class="cf-div-rombo"></span>
        <span class="cf-div-linea"></span>
      </div>

      <p id="cf-texto" class="font-crimson">
        Nos encantará saber que nos acompañarás. Permítenos preparar los
        detalles confirmando tu asistencia.
      </p>

      <div id="cf-botones">
        <a
          class="cf-boton font-cinzel"
          href={linkConfirmar}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="cf-wa" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2Zm5.6 14.1c-.2.7-1.2 1.3-1.9 1.4-.5.1-1.1.2-3.2-.7-2.7-1.1-4.4-3.9-4.5-4-.1-.2-1.1-1.4-1.1-2.7s.7-1.9.9-2.2c.2-.2.5-.3.6-.3h.5c.2 0 .4 0 .6.4l.8 2c.1.2 0 .4 0 .5l-.4.5-.3.3c-.1.1-.2.3 0 .5.2.4.8 1.3 1.7 2.1 1.1 1 2 1.3 2.3 1.4.2.1.4.1.5-.1l.8-.9c.2-.2.3-.2.5-.1l2 .9c.2.1.4.2.4.3.1.2.1.7-.2 1.7Z"
            ></path>
          </svg>
          Confirmar
        </a>
      </div>
    </div>

    <!-- ═══════ ELEFANTE (esquina inferior derecha) ═══════ -->
    <div id="dc-mariposa"><img src="/imagenes/captus.png" alt="" /></div>
  </div>
</section>

<style>
  #ceremonia-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    background: transparent;
    /* aire arriba para que no quede pegado a la fecha */
    padding: 4rem 0 1.5rem;
  }

  #dc-wrap {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
  }

  #dc-wrap img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* ═══════ ARCO ROSA ═══════ */
  #dc-arco {
    position: absolute;
    top: 0;
    left: 24cqw;
    width: 80cqw;
    /* más largo, para que el botón quede bien arriba del arco crema */
    height: 104cqw;
    z-index: 1;
    padding: 14cqw 8cqw 0;
    text-align: center;
    /* cúpula semicircular arriba, esquinas suaves abajo */
    border-radius: 40cqw 40cqw 5cqw 5cqw / 38cqw 38cqw 5cqw 5cqw;
    background-color: #8a6242;
    /* textura de puntitos como la referencia */
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.2) 1px,
      transparent 1.3px
    );
    background-size: 34px 34px;
    box-shadow: 0 12px 26px rgba(120, 85, 55, 0.24);
  }

  #dc-titulo {
    margin: 0;
    font-size: 13cqw;
    line-height: 1;
    font-weight: 400;
    color: #ffffff;
    text-shadow: 0 2px 6px rgba(95, 62, 38, 0.28);
  }

  #dc-pin {
    display: block;
    width: 8.5cqw;
    height: auto;
    margin: 2.4cqw auto 0;
  }

  #dc-salon {
    margin: 2.4cqw 0 0;
    font-size: 4.2cqw;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }

  #dc-direccion {
    margin: 1.6cqw 0 0;
    font-size: 3.5cqw;
    line-height: 1.4;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-indent: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.92);
  }

  /* la hora es el dato que más se busca: va más grande y en una chapa clara */
  #dc-hora {
    display: inline-block;
    margin: 2.6cqw 0 0;
    padding: 1.2cqw 4cqw;
    border-radius: 999px;
    /* se distingue del botón: acá va el trazo, no el relleno macizo */
    background: rgba(255, 252, 245, 0.14);
    border: 0.45cqw solid rgba(255, 252, 245, 0.9);
    font-size: 5.2cqw;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0.1em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.1em;
    color: #ffffff;
    text-shadow: 0 1px 4px rgba(95, 62, 38, 0.35);
  }

  #dc-boton {
    display: inline-block;
    margin-top: 3.4cqw;
    padding: 2.2cqw 6cqw;
    border-radius: 999px;
    background: #ffffff;
    color: #7d5538;
    font-size: 3.9cqw;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-indent: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(95, 62, 38, 0.3);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  #dc-boton:hover {
    opacity: 0.92;
  }

  #dc-boton:active {
    transform: scale(0.96);
  }

  /* ── Cactus de la izquierda, apoyado contra el arco ── */
  #dc-flor {
    position: absolute;
    top: 44cqw;
    left: -11cqw;
    width: 46cqw;
    z-index: 3;
    pointer-events: none;
  }

  #dc-flor img {
    width: 100%;
    height: auto;
  }

  /* ═══════ ARCO CREMA (por delante del rosa) ═══════ */
  #cf-arco {
    position: relative;
    z-index: 2;
    /* arranca pisando la parte baja del arco rosa, ya sin tapar el botón */
    margin: 94cqw 0 0 -6cqw;
    width: 78cqw;
    padding: 20cqw 7cqw 9cqw;
    text-align: center;
    border-radius: 39cqw 39cqw 5cqw 5cqw / 34cqw 34cqw 5cqw 5cqw;
    background-color: #f7edda;
    border: 1px solid rgba(186, 146, 104, 0.55);
    box-shadow: 0 10px 24px rgba(120, 85, 55, 0.16);
  }

  #cf-titulo {
    margin: 0;
    font-size: 12cqw;
    line-height: 1.15;
    font-weight: 400;
    color: #8a6242;
    text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  /* ── Separador dorado ── */
  #cf-divisor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2.4cqw;
    margin-top: 3cqw;
  }

  .cf-div-linea {
    display: block;
    width: 13cqw;
    height: 1px;
    background: rgba(154, 111, 69, 0.7);
  }

  .cf-div-rombo {
    display: block;
    width: 1.5cqw;
    height: 1.5cqw;
    transform: rotate(45deg);
    border: 1px solid #9a6f45;
    background: rgba(154, 111, 69, 0.25);
  }

  #cf-texto {
    margin: 3.5cqw auto 0;
    max-width: 70cqw;
    font-size: 5cqw;
    line-height: 1.6;
    font-weight: 400;
    color: #6d4830;
  }

  /* ── Botones de WhatsApp ── */
  #cf-botones {
    display: flex;
    /* uno debajo del otro */
    flex-direction: column;
    align-items: center;
    gap: 2.6cqw;
    margin-top: 4.5cqw;
  }

  .cf-boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.6cqw;
    /* ancho fijo y en una sola línea: la "m" de mami es más ancha que la "p"
       de papi y sin esto el primer botón se partía en dos renglones */
    width: 60cqw;
    white-space: nowrap;
    padding: 2.2cqw 4.6cqw;
    border-radius: 999px;
    background: #8a6242;
    color: #ffffff;
    font-size: 3.8cqw;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 3px 8px rgba(120, 85, 55, 0.32);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .cf-boton:hover {
    opacity: 0.92;
  }

  .cf-boton:active {
    transform: scale(0.96);
  }

  .cf-wa {
    width: 4.4cqw;
    height: 4.4cqw;
    fill: #ffffff;
    flex-shrink: 0;
  }

  /* ── Cactus de la esquina de abajo ── */
  #dc-mariposa {
    position: absolute;
    right: -8cqw;
    bottom: -4cqw;
    width: 40cqw;
    z-index: 4;
    pointer-events: none;
    filter: drop-shadow(0 5px 12px rgba(140, 105, 70, 0.24));
  }

  /* El volteo va en el <img>, no en el contenedor:
     GSAP anima el contenedor y pisaría el transform. */
  #dc-mariposa img {
    width: 100%;
    height: auto;
    transform: scaleX(-1);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    const itemsArco = [
      "#dc-titulo",
      "#dc-pin",
      "#dc-salon",
      "#dc-direccion",
      "#dc-hora",
      "#dc-boton",
    ];
    const itemsConf = [
      "#cf-titulo",
      "#cf-divisor",
      "#cf-texto",
      "#cf-botones",
    ];

    const inicial = () => {
      gsap.killTweensOf("#dc-mariposa");
      gsap.set("#dc-arco", { opacity: 0, y: 30, scale: 0.96 });
      gsap.set("#cf-arco", { opacity: 0, y: 30, scale: 0.96 });
      gsap.set("#dc-flor", { opacity: 0, x: "-45%" });
      gsap.set("#dc-mariposa", { opacity: 0, x: "40%", y: "15%", rotation: 0 });
      gsap.set([...itemsArco, ...itemsConf], { opacity: 0, y: 14 });
    };

    inicial();

    ScrollTrigger.create({
      trigger: "#ceremonia-section",
      start: "top 80%",
      onEnter: () => {
        const tl = gsap.timeline();
        tl.to(
          "#dc-arco",
          { opacity: 1, y: 0, scale: 1, duration: 1.2, ease: "back.out(1.2)" },
          0,
        )
          .to(
            "#dc-flor",
            { opacity: 1, x: 0, duration: 1.4, ease: "power2.out" },
            0.2,
          )
          .to(
            itemsArco,
            {
              opacity: 1,
              y: 0,
              duration: 0.9,
              stagger: 0.12,
              ease: "power2.out",
            },
            0.35,
          )
          .to(
            "#cf-arco",
            { opacity: 1, y: 0, scale: 1, duration: 1.2, ease: "back.out(1.2)" },
            0.6,
          )
          .to(
            "#dc-mariposa",
            { opacity: 1, x: 0, y: 0, duration: 1.4, ease: "power2.out" },
            0.8,
          )
          .to(
            itemsConf,
            {
              opacity: 1,
              y: 0,
              duration: 0.9,
              stagger: 0.13,
              ease: "power2.out",
            },
            0.9,
          )
          // la mariposa queda revoloteando
          .add(() => {
            gsap.to("#dc-mariposa", {
              y: -7,
              rotation: 4,
              duration: 3.2,
              repeat: -1,
              yoyo: true,
              ease: "sine.inOut",
            });
          }, 2.4);
      },
      onLeaveBack: inicial,
    });
  });
</script>
