---
// src/components/NombresFlores.astro
// Bienvenida — temática vaquerita (cowboy)
// Mismo lienzo de ancho fijo que la Portada: todo en cqw para que se vea
// igual en celular, laptop y PC. El fondo lo pone el Layout.
---

<section id="nombres-flores">
  <div id="nf-marco">
    <!-- ═══════ GUIRNALDA DE ARRIBA ═══════ -->
    <img id="nf-arriba" src="/imagenes/arriba.png" alt="" />

    <!-- ═══════ NUBES PEGADAS A LOS BORDES ═══════ -->
    <img class="nf-nube nf-nube-1" src="/imagenes/nube.png" alt="" />
    <img class="nf-nube nf-nube-2" src="/imagenes/nube.png" alt="" />

    <!-- ═══════ TEXTO ═══════ -->
    <div id="nf-texto">
      <p id="nf-invito" class="font-crimson">
        La dulce espera está por terminar, te invito a
      </p>

      <h2 id="nf-titulo" class="font-cinzel">Mi Baby Shower</h2>

      <img id="nf-sepa" src="/imagenes/sepa.png" alt="" />
    </div>

    <!-- ═══════ GLOBOS + VAQUERITO CON EL CARTEL ═══════ -->
    <div id="nf-escena">
      <img class="nf-globos nf-globos-izq" src="/imagenes/globos.png" alt="" />
      <img id="nf-nino2" src="/imagenes/nino2.png" alt="" />
      <img class="nf-globos nf-globos-der" src="/imagenes/globos.png" alt="" />
    </div>

    <!-- ═══════ ESCENA DE ABAJO ═══════ -->
    <img id="nf-abajo2" src="/imagenes/abajo2.png" alt="" />
  </div>

  <!-- 🎵 BOTÓN FLOTANTE DE MÚSICA -->
  <div
    class="fixed bottom-6 right-6 z-[9999]"
    id="boton-musica-flotante"
    style="opacity: 0;"
  >
    <button
      id="toggle-musica-global"
      class="group relative w-14 h-14 rounded-full shadow-lg flex items-center justify-center transition-all duration-200 hover:scale-110 active:scale-95"
      style="background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); border: 1px solid rgba(138,90,59,0.55);"
      aria-label="Controlar música"
    >
      <!-- ICONO PAUSE - inicia oculto -->
      <svg
        id="icono-pause-global"
        class="w-6 h-6 hidden relative z-10"
        style="color: #8a5a3b;"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M5.5 3.5A1.5 1.5 0 017 2h1a1.5 1.5 0 011.5 1.5v13A1.5 1.5 0 018 18H7a1.5 1.5 0 01-1.5-1.5v-13zm7 0A1.5 1.5 0 0114 2h1a1.5 1.5 0 011.5 1.5v13a1.5 1.5 0 01-1.5 1.5h-1a1.5 1.5 0 01-1.5-1.5v-13z"
        ></path>
      </svg>

      <!-- ICONO PLAY - inicia visible -->
      <svg
        id="icono-play-global"
        class="w-6 h-6 relative z-10"
        style="color: #8a5a3b;"
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path
          d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"
        ></path>
      </svg>

      <!-- Onda de sonido - inicia oculta -->
      <div
        class="absolute -inset-2 rounded-full hidden"
        style="border: 2px solid rgba(138,90,59,0.55);"
        id="onda-sonido"
      >
      </div>
    </button>
  </div>
</section>

<style>
  #nombres-flores {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    /* deja ver el fondo global estático del Layout */
    background: transparent;
  }

  /* ═══════ LIENZO (mismo ancho que la portada) ═══════ */
  #nf-marco {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* el padding de arriba reserva el sitio de la guirnalda
       (arriba.png es 100% de ancho y ratio 3.797 → 26.3cqw de alto) */
    padding: 22cqw 0 0;
  }

  #nf-marco img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Guirnalda de arriba, de borde a borde ── */
  #nf-arriba {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }

  /* ── Nubes de los costados ── */
  .nf-nube {
    position: absolute;
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  .nf-nube-1 {
    top: 58cqw;
    left: -7cqw;
    width: 27cqw;
  }

  .nf-nube-2 {
    top: 64cqw;
    right: -6cqw;
    width: 24cqw;
  }

  /* ── Texto ── */
  #nf-texto {
    position: relative;
    width: 92cqw;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    z-index: 4;
  }

  #nf-invito {
    margin: 6cqw 0 0;
    font-size: 6.2cqw;
    line-height: 1.35;
    font-weight: 400;
    color: #6d4830;
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.8);
  }

  #nf-titulo {
    margin: 2.2cqw 0 0;
    font-size: 8cqw;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: 0.02em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #6b4326;
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.8);
  }

  #nf-sepa {
    width: 42cqw;
    height: auto;
    margin-top: 2.5cqw;
  }

  /* ── Globos + vaquerito con el cartel del nombre ── */
  #nf-escena {
    position: relative;
    width: 100%;
    margin-top: 16cqw;
    display: flex;
    justify-content: center;
    z-index: 3;
  }

  #nf-nino2 {
    width: 70cqw;
    height: auto;
    filter: drop-shadow(0 8px 16px rgba(150, 115, 80, 0.18));
  }

  .nf-globos {
    position: absolute;
    top: 6cqw;
    width: 27cqw;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }

  .nf-globos-izq {
    left: -3cqw;
    /* espejados para que el moño mire al centro */
    transform: scaleX(-1);
  }

  .nf-globos-der {
    right: -3cqw;
  }

  /* ── Escena de abajo ── */
  #nf-abajo2 {
    width: 100%;
    height: auto;
    margin-top: 2cqw;
    z-index: 2;
  }

  /* ── Botón de música ── */
  #onda-sonido {
    animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping-slow {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    75%,
    100% {
      transform: scale(1.3);
      opacity: 0;
    }
  }

  @keyframes pulse-subtle {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  #boton-musica-flotante button {
    animation: pulse-subtle 3s ease-in-out infinite;
  }

  #boton-musica-flotante button:hover {
    animation: none;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // ── Entrada animada ───────────────────────────────────────
    // La guirnalda cae, el texto se abre desde los costados, el vaquerito
    // sube con su cartel y los globos llegan de cada lado.
    const nubes = [".nf-nube-1", ".nf-nube-2"];

    const inicial = () => {
      gsap.killTweensOf(nubes);
      gsap.set("#nf-arriba", { opacity: 0, y: "-40%" });
      gsap.set("#nf-invito", { opacity: 0, x: -40 });
      gsap.set("#nf-titulo", { opacity: 0, x: 40 });
      gsap.set("#nf-sepa", { opacity: 0, y: 10 });
      gsap.set("#nf-nino2", { opacity: 0, y: 46, scale: 0.92 });
      gsap.set(".nf-globos-izq", { opacity: 0, x: -40, y: 20 });
      gsap.set(".nf-globos-der", { opacity: 0, x: 40, y: 20 });
      gsap.set("#nf-abajo2", { opacity: 0, y: 30 });
      gsap.set(nubes, { opacity: 0, scale: 0.8 });
      // la nube de la izquierda va espejada (el volteo se hace acá y no en
      // CSS: GSAP escribe el transform y pisaría un scaleX de la hoja)
      gsap.set(".nf-nube-1", { scaleX: -0.8 });
    };

    inicial();

    const flotar = () => {
      gsap.to(".nf-nube-1", {
        x: 10, y: -8,
        duration: 3.4, repeat: -1, yoyo: true, ease: "sine.inOut",
      });
      gsap.to(".nf-nube-2", {
        x: -9, y: -10,
        duration: 3.9, repeat: -1, yoyo: true, ease: "sine.inOut", delay: 0.5,
      });
    };

    const armarEntrada = () => {
      ScrollTrigger.create({
        trigger: "#nombres-flores",
        start: "top 85%",
        onEnter: () => {
          const tl = gsap.timeline();
          tl.to("#nf-arriba", { opacity: 1, y: 0, duration: 1.6, ease: "power2.out" }, 0)
            .to("#nf-invito", { opacity: 1, x: 0, duration: 1.4, ease: "power3.out" }, 0.1)
            .to("#nf-titulo", { opacity: 1, x: 0, duration: 1.4, ease: "power3.out" }, 0.2)
            .to("#nf-sepa", { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" }, 0.3)
            .to(
              "#nf-nino2",
              { opacity: 1, y: 0, scale: 1, duration: 1.5, ease: "back.out(1.2)" },
              0.35,
            )
            .to(
              [".nf-globos-izq", ".nf-globos-der"],
              {
                opacity: 1, x: 0, y: 0,
                duration: 1.5, stagger: 0.12, ease: "back.out(1.4)",
              },
              0.45,
            )
            .to("#nf-abajo2", { opacity: 1, y: 0, duration: 1.4, ease: "power2.out" }, 0.5)
            .to(
              nubes,
              { opacity: 1, scale: 1, duration: 1.2, stagger: 0.1, ease: "power2.out" },
              0.4,
            )
            .to(
              ".nf-nube-1",
              { scaleX: -1, duration: 1.2, ease: "power2.out" },
              0.4,
            )
            .add(flotar, 2.1);
        },
        // al volver a subir se rearma, así la animación se repite en cada bajada
        onLeaveBack: inicial,
      });

      ScrollTrigger.refresh();
    };

    // Esta sección queda detrás de la portada, así que al cargar la página ya
    // está "en pantalla" y la animación se gastaría sin que nadie la vea.
    // Por eso se arma recién cuando el invitado abre el sobre. Si la portada
    // no está en uso, arranca de una.
    const hayPortada = document.getElementById("portada-section");

    if (!hayPortada || (window as any).invitacionAbierta) {
      armarEntrada();
    } else {
      window.addEventListener("invitacion-abierta", armarEntrada, {
        once: true,
      });
    }

    // ── Botón flotante de música ──────────────────────────────
    const botonToggle = document.getElementById("toggle-musica-global");
    const iconoPlay = document.getElementById("icono-play-global");
    const iconoPause = document.getElementById("icono-pause-global");
    const ondaSonido = document.getElementById("onda-sonido");
    const botonFlotante = document.getElementById("boton-musica-flotante");

    if (botonFlotante) botonFlotante.style.opacity = "1";

    // Sincronizar estado visual al cargar (por si la música ya venía corriendo desde Portada)
    function sincronizarEstadoInicial() {
      const estadoActual = (window as any).estaReproduciendoGlobal;
      if (estadoActual) {
        iconoPlay?.classList.add("hidden");
        iconoPause?.classList.remove("hidden");
        ondaSonido?.classList.remove("hidden");
      }
    }

    sincronizarEstadoInicial();

    // Portada dispara este evento cuando el invitado toca el sobre
    window.addEventListener("musica-iniciada", () => {
      iconoPlay?.classList.add("hidden");
      iconoPause?.classList.remove("hidden");
      ondaSonido?.classList.remove("hidden");
    });

    botonToggle?.addEventListener("click", () => {
      const audioActual = (window as any).audioGlobal;
      const estadoActual = (window as any).estaReproduciendoGlobal;

      if (estadoActual && audioActual) {
        audioActual.pause();
        (window as any).estaReproduciendoGlobal = false;
        iconoPause?.classList.add("hidden");
        iconoPlay?.classList.remove("hidden");
        ondaSonido?.classList.add("hidden");
      } else if (audioActual) {
        audioActual.play().catch(() => {});
        (window as any).estaReproduciendoGlobal = true;
        iconoPlay?.classList.add("hidden");
        iconoPause?.classList.remove("hidden");
        ondaSonido?.classList.remove("hidden");
      }
    });
  });
</script>
