---
// src/components/Despedida.astro
// Cierre de la invitación: la guirnalda de arriba, el agradecimiento y la
// cerca cerrando abajo. Mismo lienzo y misma paleta que el resto.
---

<section id="despedida-section">
  <div id="de-wrap">
    <!-- ═══════ GUIRNALDA DE ARRIBA ═══════ -->
    <img id="de-arriba" src="/imagenes/arriba.png" alt="" />

    <!-- ═══════ TEXTO ═══════ -->
    <p id="de-gracias" class="font-cinzel">Gracias por acompañarnos</p>

    <h2 id="de-titulo" class="font-great-vibes">¡Te esperamos!</h2>

    <img id="de-sepa" src="/imagenes/sepa.png" alt="" />

    <p id="de-texto" class="font-crimson">
      Tu presencia hace de este día un recuerdo para toda la vida. Nos vemos
      para celebrar juntos la llegada de nuestro vaquerito.
    </p>

    <!-- ═══════ CABALLITO ═══════ -->
    <img id="de-caballo" src="/imagenes/caballo.png" alt="" />

    <!-- ═══════ CERCA ═══════ -->
    <img id="de-cerca" src="/imagenes/cerca.png" alt="" />
  </div>
</section>

<style>
  #despedida-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow: hidden;
    /* deja ver el fondo global estático del Layout */
    background: transparent;
  }

  /* ═══════ LIENZO (mismo ancho que el resto) ═══════ */
  #de-wrap {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    /* el padding de arriba reserva el sitio de la guirnalda
       (arriba.png es 100% de ancho y ratio 3.797 → 26.3cqw de alto) */
    padding: 32cqw 0 0;
  }

  #de-wrap img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* ── Guirnalda de arriba, de borde a borde ── */
  #de-arriba {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }

  /* ── Texto ── */
  #de-gracias {
    margin: 0;
    font-size: 4.6cqw;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.16em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.16em;
    text-transform: uppercase;
    color: #9a6f45;
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.8);
  }

  #de-titulo {
    margin: 1.5cqw 0 0;
    /* Great Vibes no tolera versales ni espaciado entre letras */
    font-size: 15cqw;
    line-height: 1.25;
    font-weight: 400;
    color: #8a6242;
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.8);
  }

  #de-sepa {
    width: 38cqw;
    height: auto;
    margin-top: 2cqw;
  }

  #de-texto {
    width: 78cqw;
    margin: 4cqw 0 0;
    font-size: 4.8cqw;
    line-height: 1.6;
    font-weight: 400;
    color: #6d4830;
    text-shadow: 0 1px 0 rgba(255, 252, 245, 0.8);
  }

  /* ── Caballito ── */
  #de-caballo {
    width: 46cqw;
    height: auto;
    margin-top: 5cqw;
    filter: drop-shadow(0 6px 12px rgba(150, 115, 80, 0.18));
  }

  /* ── Cerca de abajo ── */
  #de-cerca {
    width: 100%;
    height: auto;
    /* sube hasta que el caballito quede apoyado en la cerca */
    margin-top: -8cqw;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // ── Entrada animada ───────────────────────────────────────
    const inicial = () => {
      gsap.set("#de-arriba", { opacity: 0, y: "-40%" });
      gsap.set("#de-gracias", { opacity: 0, y: -14 });
      gsap.set("#de-titulo", { opacity: 0, y: 18 });
      gsap.set("#de-sepa", { opacity: 0, scaleX: 0.6 });
      gsap.set("#de-texto", { opacity: 0, y: 16 });
      gsap.set("#de-caballo", { opacity: 0, y: 26, scale: 0.9 });
      gsap.set("#de-cerca", { opacity: 0, y: 24 });
    };

    inicial();

    const armarEntrada = () => {
      ScrollTrigger.create({
        trigger: "#despedida-section",
        start: "top 85%",
        onEnter: () => {
          const tl = gsap.timeline();
          tl.to("#de-arriba", { opacity: 1, y: 0, duration: 1.6, ease: "power2.out" }, 0)
            .to("#de-gracias", { opacity: 1, y: 0, duration: 1.2, ease: "power3.out" }, 0.1)
            .to("#de-titulo", { opacity: 1, y: 0, duration: 1.3, ease: "power3.out" }, 0.2)
            .to("#de-sepa", { opacity: 1, scaleX: 1, duration: 1.1, ease: "power2.out" }, 0.3)
            .to("#de-texto", { opacity: 1, y: 0, duration: 1.3, ease: "power2.out" }, 0.4)
            .to(
              "#de-caballo",
              { opacity: 1, y: 0, scale: 1, duration: 1.4, ease: "back.out(1.2)" },
              0.5,
            )
            .to("#de-cerca", { opacity: 1, y: 0, duration: 1.3, ease: "power2.out" }, 0.6);
        },
        // al volver a subir se rearma, así la animación se repite en cada bajada
        onLeaveBack: inicial,
      });

      ScrollTrigger.refresh();
    };

    // Igual que el resto de secciones: recién anima cuando el invitado abre
    // el sobre, así la animación no se gasta detrás de la portada.
    const hayPortada = document.getElementById("portada-section");

    if (!hayPortada || (window as any).invitacionAbierta) {
      armarEntrada();
    } else {
      window.addEventListener("invitacion-abierta", armarEntrada, {
        once: true,
      });
    }
  });
</script>
