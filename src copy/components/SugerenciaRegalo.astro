---
// src/components/SugerenciaRegalo.astro
// Sugerencia de regalos: tarjeta crema con borde de cuerda, en la misma
// paleta vaquera del resto de la invitación. El botón abre el link en una
// pestaña nueva (en el celular lo toma el visor nativo).

// Cambiá esto por el link de la lista, el catálogo o la tienda.
const link = "https://canva.link/wocyh5fvb3d4w93";
const textoBoton = "Ver sugerencias";
---

<section id="regalos-section">
  <div id="sr-wrap">
    <!-- ═══════ TARJETA ═══════ -->
    <div id="sr-card">
      <!-- caballito apoyado en el borde de arriba -->
      <img id="sr-caballo" src="/imagenes/caballo.png" alt="" />

      <!-- regalo arriba del título (la silueta se pinta por CSS, el PNG es negro) -->
      <span id="sr-regalos-img" role="img" aria-label="Regalo"></span>

      <!-- ── Título ── -->
      <p id="sr-sugerencia" class="font-great-vibes">Sugerencia</p>
      <p id="sr-regalos" class="font-cinzel">De regalos</p>

      <img id="sr-sepa" src="/imagenes/sepa.png" alt="" />

      <!-- ── Texto ── -->
      <p id="sr-texto" class="font-crimson">
        Tu presencia es nuestro mejor regalo. Si querés tener un detalle con
        nuestro vaquerito, acá te dejamos algunas ideas.
      </p>

      <!-- ── Botón ── -->
      <a
        id="sr-boton"
        class="font-cinzel"
        href={link}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="sr-icono" viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M20 7h-2.2a3 3 0 0 0-.5-3.4A3 3 0 0 0 12 3.6a3 3 0 0 0-5.3-.1A3 3 0 0 0 6.2 7H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h7V7h2v5h7a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1Zm-6.3 0a1 1 0 1 1 1.6-1.2A1 1 0 0 1 13.7 7Zm-4.9-.9A1 1 0 0 1 10.3 7H9a1 1 0 0 1-.2-.9ZM4.5 13.5V20a1 1 0 0 0 1 1H11v-7.5Zm8.5 0V21h5.5a1 1 0 0 0 1-1v-6.5Z"
          ></path>
        </svg>
        {textoBoton}
      </a>

    </div>

    <!-- escena de abajo, apoyada bajo la tarjeta -->
    <img id="sr-abajo2" src="/imagenes/abajo2.png" alt="" />
  </div>
</section>

<style>
  #regalos-section {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    overflow-x: hidden;
    /* deja ver el fondo global estático del Layout */
    background: transparent;
    padding: 3rem 0 2rem;
  }

  #sr-wrap {
    position: relative;
    width: min(100vw, 480px);
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #sr-wrap img {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* ═══════ TARJETA ═══════ */
  #sr-card {
    position: relative;
    z-index: 1;
    width: 86cqw;
    padding: 16cqw 8cqw 9cqw;
    text-align: center;
    border-radius: 6cqw;
    background-color: #f7edda;
    /* doble trazo: el de afuera hace de cuerda */
    border: 0.5cqw solid #b9885a;
    outline: 0.25cqw solid rgba(154, 111, 69, 0.45);
    outline-offset: 1.4cqw;
    box-shadow: 0 10px 24px rgba(120, 85, 55, 0.16);
  }

  #sr-caballo {
    position: absolute;
    top: -17cqw;
    left: 50%;
    transform: translateX(-50%);
    width: 30cqw;
    height: auto;
    z-index: 2;
    filter: drop-shadow(0 4px 8px rgba(120, 85, 55, 0.22));
  }

  /* el PNG del regalo es una silueta negra: se pinta con mask para que
     tome el café de la invitación */
  #sr-regalos-img {
    display: block;
    width: 12cqw;
    height: 12cqw;
    margin: 0 auto 1.5cqw;
    background-color: #8a6242;
    -webkit-mask: url("/imagenes/regalo.png") center / contain no-repeat;
    mask: url("/imagenes/regalo.png") center / contain no-repeat;
  }

  /* ── Título ── */
  #sr-sugerencia {
    margin: 0;
    /* Great Vibes no tolera versales ni espaciado entre letras */
    font-size: 12cqw;
    line-height: 1.1;
    font-weight: 400;
    color: #8a6242;
  }

  #sr-regalos {
    margin: 0.4cqw 0 0;
    font-size: 5cqw;
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: 0.16em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.16em;
    text-transform: uppercase;
    color: #9a6f45;
  }

  #sr-sepa {
    width: 34cqw;
    height: auto;
    margin: 2.5cqw auto 0;
  }

  /* ── Texto ── */
  #sr-texto {
    margin: 3.5cqw auto 0;
    max-width: 62cqw;
    font-size: 4.6cqw;
    line-height: 1.6;
    font-weight: 400;
    color: #6d4830;
  }

  /* ── Botón ── */
  #sr-boton {
    display: inline-flex;
    align-items: center;
    gap: 2cqw;
    margin-top: 5cqw;
    padding: 2.4cqw 6.5cqw;
    border-radius: 999px;
    background: #8a6242;
    color: #fffdf8;
    font-size: 3.9cqw;
    font-weight: 600;
    letter-spacing: 0.1em;
    /* compensa el espacio que letter-spacing deja tras la última letra */
    text-indent: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
    text-decoration: none;
    box-shadow: 0 3px 10px rgba(95, 62, 38, 0.3);
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  #sr-boton:hover {
    opacity: 0.92;
  }

  #sr-boton:active {
    transform: scale(0.96);
  }

  .sr-icono {
    width: 4.6cqw;
    height: 4.6cqw;
    fill: currentColor;
    flex: none;
  }

  /* ── Escena de abajo ── */
  #sr-abajo2 {
    position: relative;
    /* sube hasta meterse detrás de la tarjeta */
    margin-top: -16cqw;
    width: 100%;
    height: auto;
    z-index: 0;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    // ── Entrada animada ───────────────────────────────────────
    const items = [
      "#sr-sugerencia",
      "#sr-regalos",
      "#sr-sepa",
      "#sr-texto",
      "#sr-boton",
    ];

    const inicial = () => {
      gsap.set("#sr-card", { opacity: 0, y: 34, scale: 0.96 });
      gsap.set("#sr-regalos-img", { opacity: 0, y: -12, scale: 0.85 });
      gsap.set("#sr-caballo", { opacity: 0, y: -20, scale: 0.85 });
      gsap.set("#sr-abajo2", { opacity: 0, y: 26 });
      gsap.set(items, { opacity: 0, y: 14 });
    };

    inicial();

    const armarEntrada = () => {
      ScrollTrigger.create({
        trigger: "#regalos-section",
        start: "top 85%",
        onEnter: () => {
          const tl = gsap.timeline();
          tl.to(
            "#sr-card",
            { opacity: 1, y: 0, scale: 1, duration: 1.3, ease: "back.out(1.1)" },
            0,
          )
            .to(
              "#sr-caballo",
              { opacity: 1, y: 0, scale: 1, duration: 1.2, ease: "back.out(1.5)" },
              0.15,
            )
            .to(
              "#sr-regalos-img",
              { opacity: 1, y: 0, scale: 1, duration: 1.2, ease: "back.out(1.5)" },
              0.2,
            )
            .to(
              items,
              { opacity: 1, y: 0, duration: 1.1, stagger: 0.1, ease: "power2.out" },
              0.3,
            )
            .to(
              "#sr-abajo2",
              { opacity: 1, y: 0, duration: 1.3, ease: "power2.out" },
              0.45,
            );
        },
        // al volver a subir se rearma, así la animación se repite en cada bajada
        onLeaveBack: inicial,
      });

      ScrollTrigger.refresh();
    };

    // Igual que el resto de secciones: recién anima cuando el invitado abre
    // el sobre, así la animación no se gasta detrás de la portada.
    const hayPortada = document.getElementById("portada-section");

    if (!hayPortada || (window as any).invitacionAbierta) {
      armarEntrada();
    } else {
      window.addEventListener("invitacion-abierta", armarEntrada, {
        once: true,
      });
    }
  });
</script>
